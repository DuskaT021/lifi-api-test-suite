        "key": "baseUrl",
        "value": "https://li.quest/v1"
      },
      {
        "key": "apiKey",
        "value": "",
        "description": "Optional \u2014 add for higher rate limits"
      },
      {
        "key": "fromChain",
        "value": "137",
        "description": "Polygon"
      },
      {
        "key": "toChain",
        "value": "42161",
        "description": "Arbitrum"
      },
      {
        "key": "fromToken",
        "value": "0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174",
        "description": "USDC on Polygon"
      },
      {
        "key": "toToken",
        "value": "USDC"
      },
      {
        "key": "fromAddress",
        "value": "0x552008c0f6870c2f77e5cC1d2eb9bdff03e30Ea0"
      },
      {
        "key": "fromAmount",
        "value": "1000000",
        "description": "1 USDC (6 decimals)"
      }
