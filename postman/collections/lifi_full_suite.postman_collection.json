    "item": [
      {
        "name": "Tokens (/tokens)",
        "description": "Cached endpoint \u2014 large payload, filter by chain always",
        "item": [
          {
            "name": "Basic Response",
            "item": [
              {
                "name": "GET /tokens \u2014 Polygon (single chain)",
                "event": [
                  {
                    "listen": "test",
                    "script": {
                      "exec": [
                        "pm.test('Status 200', () => pm.response.to.have.status(200));",
                        "pm.test('Response time < 5000ms', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                        "pm.test('Response is object', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  pm.expect(data).to.be.an('object');",
                        "  pm.expect(Object.keys(data).length).to.be.greaterThan(0);",
                        "});",
                        "pm.test('Keys are chain IDs', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  Object.keys(data).forEach(key => {",
                        "    pm.expect(parseInt(key)).to.not.be.NaN;",
                        "  });",
                        "});",
                        "pm.test('Each chain has array of tokens', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  Object.entries(data).forEach(([chainId, tokens]) => {",
                        "    pm.expect(tokens, `Chain ${chainId}`).to.be.an('array');",
                        "    pm.expect(tokens.length).to.be.greaterThan(0);",
                        "  });",
                        "});",
                        "// Store first token for field validation",
                        "const tokenData = pm.response.json().tokens;",
                        "const firstTokens = Object.values(tokenData)[0];",
                        "if (firstTokens && firstTokens.length > 0) {",
                        "  pm.collectionVariables.set('sampleToken', JSON.stringify(firstTokens[0]));",
                        "}"
                      ]
                    }
                  }
                ],
                "request": {
                  "method": "GET",
                  "url": {
                    "raw": "{{baseUrl}}/tokens?chains=137",
                    "host": [
                      "{{baseUrl}}"
                    ],
                    "path": [
                      "tokens"
                    ],
                    "query": [
                      {
                        "key": "chains",
                        "value": "137"
                      }
                    ]
                  }
                }
              },
              {
                "name": "GET /tokens \u2014 Token field validation",
                "event": [
                  {
                    "listen": "test",
                    "script": {
                      "exec": [
                        "pm.test('Status 200', () => pm.response.to.have.status(200));",
                        "pm.test('Tokens have required fields', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  const tokens = Object.values(data).flat().slice(0, 20);",
                        "  const required = ['address', 'symbol', 'decimals', 'chainId', 'name', 'priceUSD'];",
                        "  tokens.forEach(token => {",
                        "    required.forEach(field => {",
                        "      pm.expect(token, `Missing ${field}`).to.have.property(field);",
                        "    });",
                        "  });",
                        "});",
                        "pm.test('Token addresses are valid hex', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  const tokens = Object.values(data).flat().slice(0, 20);",
                        "  tokens.forEach(token => {",
                        "    pm.expect(token.address).to.match(/^0x[a-fA-F0-9]{40}$/);",
                        "  });",
                        "});",
                        "pm.test('Decimals are non-negative numbers', () => {",
                        "  const data = pm.response.json().tokens;",
                        "  const tokens = Object.values(data).flat().slice(0, 20);",
                        "  tokens.forEach(token => {",
                        "    pm.expect(token.decimals).to.be.a('number');",
                        "    pm.expect(token.decimals).to.be.at.least(0);",
                        "  });",
                        "});",
                        "pm.test('No sensitive data in response', () => {",
                        "  const body = pm.response.text();",
                        "  pm.expect(body).to.not.match(/private.?key/i);",
                        "  pm.expect(body).to.not.match(/password/i);",
                        "  pm.expect(body).to.not.match(/mnemonic/i);",
                        "});"
                      ]
                    }
                  }
                ],
                "request": {
                  "method": "GET",
                  "url": {
                    "raw": "{{baseUrl}}/tokens?chains=1",
                    "host": [
                      "{{baseUrl}}"
                    ],
                    "path": [
                      "tokens"
                    ],
                    "query": [
                      {
                        "key": "chains",
                        "value": "1"
                      }
                    ]
                  }
                }
              }
            ]
          },
