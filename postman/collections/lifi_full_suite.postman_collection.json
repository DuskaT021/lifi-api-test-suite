        "item": [
          {
            "name": "Happy Path",
            "item": [
              {
                "name": "GET /quote \u2014 USDC Polygon \u2192 USDC Arbitrum",
                "event": [
                  {
                    "listen": "test",
                    "script": {
                      "exec": [
                        "pm.test('Status 200', () => pm.response.to.have.status(200));",
                        "pm.test('Response time < 10000ms', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
                        "",
                        "pm.test('Has required fields', () => {",
                        "  const data = pm.response.json();",
                        "  ['type', 'id', 'tool', 'action', 'estimate'].forEach(field => {",
                        "    pm.expect(data, `Missing: ${field}`).to.have.property(field);",
                        "  });",
                        "});",
                        "",
                        "pm.test('estimate has required fields', () => {",
                        "  const est = pm.response.json().estimate;",
                        "  ['fromAmount', 'toAmount', 'toAmountMin', 'approvalAddress', 'executionDuration'].forEach(f => {",
                        "    pm.expect(est, `Missing estimate.${f}`).to.have.property(f);",
                        "  });",
                        "});",
                        "",
                        "pm.test('toAmount is greater than 0', () => {",
                        "  const est = pm.response.json().estimate;",
                        "  pm.expect(parseFloat(est.toAmount)).to.be.greaterThan(0);",
                        "});",
                        "",
                        "pm.test('approvalAddress is valid Ethereum address', () => {",
                        "  const est = pm.response.json().estimate;",
                        "  pm.expect(est.approvalAddress).to.match(/^0x[a-fA-F0-9]{40}$/);",
                        "});",
                        "",
                        "pm.test('transactionRequest is present and valid', () => {",
                        "  const tx = pm.response.json().transactionRequest;",
                        "  pm.expect(tx).to.exist;",
                        "  pm.expect(tx.to).to.be.a('string').and.match(/^0x/);",
                        "  pm.expect(tx.data).to.be.a('string').and.match(/^0x/);",
                        "});",
                        "",
                        "// Store quote id for potential follow-up tests",
                        "pm.collectionVariables.set('lastQuoteId', pm.response.json().id);"
                      ]
                    }
                  }
                ],
                "request": {
                  "method": "GET",
                  "url": {
