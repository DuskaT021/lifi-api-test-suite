{
  "name": "lifi-api-test-suite",
  "version": "1.0.0",
  "private": true,
  "description": "LI.FI API test suite (Playwright + Postman/Newman)",
  "scripts": {
    "test": "playwright test",
    "test:tokens": "playwright test playwright/tests/tokens.spec.ts",
    "test:quote": "playwright test playwright/tests/quote.spec.ts",
    "test:composer": "playwright test playwright/tests/composer.spec.ts",
    "test:mcp": "playwright test playwright/tests/mcp-parity.spec.ts",
    "test:postman": "node scripts/newman-run.js",
    "test:postman:bail": "node scripts/newman-run.js --bail",
    "test:postman:quote": "node scripts/newman-run.js --collection=quote",
    "test:postman:connections": "node scripts/newman-run.js --collection=\"Connections (/connections)\"",
    "test:postman:chains": "node scripts/newman-run.js --collection=\"Chains (/chains)\"",
    "test:postman:tools": "node scripts/newman-run.js --collection=\"Tools (/tools)\"",
    "postman:data:agentic": "node scripts/generate-postman-agentic-data.js",
    "test:postman:agentic": "node scripts/newman-run.js --collection=\"Agentic Scenarios\" --iteration-data=postman/data/agentic-scenarios.postman_data.json",
    "scenarios": "ts-node mcp/mcp-test-scenarios.ts",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.82.0",
    "dotenv": "17.4.1",
    "newman": "6.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "25.5.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  }
}
