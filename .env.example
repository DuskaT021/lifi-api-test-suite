# Anthropic API key - optional, only needed for AI-assisted test scenario generation
# Get yours at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM provider for scenario generation - optional, defaults to 'anthropic'
# Valid options: anthropic
# To add a new provider, implement LLMProvider in mcp/llm-provider.ts
LLM_PROVIDER=anthropic

# LI.FI API key - optional, increases rate limits from 200 req/2h to 200 req/min
# Get yours at https://apidashboard.li.fi
LIFI_API_KEY=your_lifi_api_key_here
